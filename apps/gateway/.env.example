EECP_GATEWAY_ID=GW-LAB-A
EECP_GATEWAY_ROOM_ID=LAB-A
EECP_GATEWAY_VERSION=1.0.0
EECP_GATEWAY_LISTEN_HOST=0.0.0.0
EECP_GATEWAY_LISTEN_PORT=8443
EECP_GATEWAY_TLS_CERTFILE=C:\ProgramData\EECP\tls\gateway.crt
EECP_GATEWAY_TLS_KEYFILE=C:\ProgramData\EECP\tls\gateway.key
EECP_GATEWAY_BACKEND_WS_URL=wss://backend.example.edu/api/v2/gateways/ws
EECP_GATEWAY_BOOTSTRAP_TOKEN=replace-at-deployment
EECP_AGENT_GATEWAY_TOKEN=replace-at-deployment
EECP_GATEWAY_RECONNECT_INITIAL_SECONDS=1
EECP_GATEWAY_RECONNECT_MAX_SECONDS=30
EECP_GATEWAY_PRESENCE_TIMEOUT_SECONDS=15
EECP_GATEWAY_HEALTH_INTERVAL_SECONDS=5

# Development only; never silently enables plaintext WS.
EECP_GATEWAY_ALLOW_PLAINTEXT_WS=false
