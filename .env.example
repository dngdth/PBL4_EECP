# Copy to .env and replace every placeholder. Never commit the populated file.
EECP_ENVIRONMENT=production-like
# Machine B identity/control settings. Use the same Agent ID in Gateway credentials.
EECP_AGENT_ID=AGT-001
EECP_POLICY_MODE=enforce
EECP_GATEWAY_URL=wss://gateway.example.edu:8443/ws/agents
EECP_GATEWAY_ALLOW_PLAINTEXT_WS=false
EECP_POSTGRES_PASSWORD=replace-with-random-secret
EECP_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
EECP_EXAMINER_USERNAME=examiner
EECP_EXAMINER_ROLE=ADMIN
EECP_EXAMINER_PASSWORD_HASH='pbkdf2-sha256$replace$safely-generated-value'
EECP_GATEWAY_BOOTSTRAP_TOKEN=per-gateway-operational-secret
EECP_GATEWAY_CREDENTIALS_JSON={"GW-A":{"secret_sha256":"sha256-hex","revoked":false}}
EECP_AGENT_GATEWAY_TOKEN=per-agent-operational-secret
EECP_LOCAL_SECURITY_EVENT_TOKEN=replace-with-a-random-machine-local-secret
EECP_AGENT_CREDENTIALS_JSON={"AGT-001":{"secret_sha256":"sha256-hex","revoked":false}}
# Agent Client host only: CA bundle that validates the Local Gateway certificate.
EECP_GATEWAY_CA_FILE=C:\ProgramData\EECP\certs\gateway-ca.crt
EECP_POLICY_SIGNING_KEY=replace-with-random-policy-signing-secret
EECP_COMMAND_SIGNING_KEY=replace-with-random-command-signing-secret
# Configure the following only on the privileged Windows Service host. HMAC
# verification uses the matching Backend signing secret. Never expose either to
# Agent Client or Gateway.
EECP_POLICY_VERIFICATION_KEY=same-secret-as-policy-signing-key
EECP_REQUIRE_SIGNED_POLICY=true
EECP_COMMAND_VERIFICATION_KEY=same-secret-as-command-signing-key
EECP_REQUIRE_AUTHORIZED_COMMANDS=true
EECP_COMMAND_REPLAY_PATH=C:\ProgramData\EECP\command-replay.json
EECP_GATEWAY_ID=GW-A
EECP_GATEWAY_ROOM_ID=LAB-A
EECP_GATEWAY_BACKEND_QUEUE_MAX_MESSAGES=4096
EECP_GATEWAY_BACKEND_WS_URL=wss://api.example.edu/api/v2/gateways/ws
# Same-server Compose override: Backend WSS is provided inside the Docker network.
# Use compose.yaml + compose.gateway-server.yaml; certificate SAN must include
# gateway-backend-tls as well as the server DNS/IP used by Agent Clients.
EECP_GATEWAY_BACKEND_CA_FILE_HOST=./local-secrets/ca.crt
# Native Gateway process only (not a Docker path):
# EECP_GATEWAY_BACKEND_CA_FILE=C:\ProgramData\EECP\certs\ca.crt
EECP_GATEWAY_TLS_CERTFILE_HOST=./local-secrets/gateway.crt
EECP_GATEWAY_TLS_KEYFILE_HOST=./local-secrets/gateway.key

# Agent Client only: compressed RAM context; no browser extension required.
EECP_SCREEN_ENABLED=true
EECP_SCREEN_INTERVAL_SECONDS=3
EECP_SCREEN_LOW_WIDTH=960
EECP_SCREEN_HIGH_WIDTH=2560
EECP_SCREEN_PRE_SECONDS=30
EECP_SCREEN_POST_SECONDS=15
EECP_SCREEN_RING_MAX_FRAMES=15
EECP_SCREEN_RING_MAX_BYTES=8388608
EECP_SCREEN_RETENTION_SECONDS=900
EECP_SCREEN_EVIDENCE_MAX_BYTES=33554432
EECP_SCREEN_EVIDENCE_MAX_ITEMS=64
# Native Gateway path; Compose overrides this inside its persistent volume.
EECP_GATEWAY_SCREEN_SPOOL_PATH=./data/gateway-screen
EECP_GATEWAY_SCREEN_MAX_BYTES=536870912
EECP_GATEWAY_SCREEN_PER_AGENT_BYTES=33554432
EECP_GATEWAY_SCREEN_TTL_SECONDS=86400
# Native Backend path; Compose mounts /service/screens in screen-evidence volume.
EECP_SCREEN_STORAGE_PATH=./data/screens
EECP_SCREEN_SERVER_RETENTION_DAYS=14
EECP_SCREEN_SERVER_MAX_BYTES=10737418240
EECP_SCREEN_INGEST_CONCURRENCY=8
