# Copy to .env and replace every placeholder. Never commit the populated file.
EECP_POSTGRES_PASSWORD=replace-with-random-secret
EECP_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
EECP_EXAMINER_USERNAME=examiner
EECP_EXAMINER_ROLE=ADMIN
EECP_EXAMINER_PASSWORD_HASH=pbkdf2-sha256$replace$safely-generated-value
EECP_GATEWAY_BOOTSTRAP_TOKEN=per-gateway-operational-secret
EECP_GATEWAY_CREDENTIALS_JSON={"GW-A":{"secret_sha256":"sha256-hex","revoked":false}}
EECP_AGENT_GATEWAY_TOKEN=per-agent-operational-secret
EECP_AGENT_CREDENTIALS_JSON={"AGT-001":{"secret_sha256":"sha256-hex","revoked":false}}
EECP_POLICY_SIGNING_KEY=replace-with-random-policy-signing-secret
EECP_COMMAND_SIGNING_KEY=replace-with-random-command-signing-secret
# Configure only on the privileged Windows Service host; never expose to Agent Client.
EECP_COMMAND_VERIFICATION_KEY=replace-with-random-command-verification-secret
EECP_REQUIRE_AUTHORIZED_COMMANDS=true
EECP_GATEWAY_ID=GW-A
EECP_GATEWAY_ROOM_ID=LAB-A
EECP_GATEWAY_BACKEND_WS_URL=wss://api.example.edu/api/v2/gateways/ws
EECP_GATEWAY_TLS_CERTFILE_HOST=./local-secrets/gateway.crt
EECP_GATEWAY_TLS_KEYFILE_HOST=./local-secrets/gateway.key
